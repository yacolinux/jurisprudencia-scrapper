# El MVP puede arrancar sin claves; con OpenCode usa un modelo gratuito.
# Compose expone las tres apps por separado: archivo, consulta y portal.
ARCHIVE_PORT=3000
QUERY_PORT=3001
PORTAL_PORT=3002
# PORT solo se usa al ejecutar npm start directamente.
PORT=3000
# Directorio del host que se monta en /data dentro del contenedor.
DATA_DIR=./data
# Para el acceso más confiable al portal, ejecutar antes:
# DISPLAY=:0 ./scripts/start-host-chrome.sh
# JURIS_ACCESS_MODE=browser
# Opcional: usar una sesión Chrome externa del host (modo CDP)
# JURIS_CDP_URL=http://127.0.0.1:9222
JURIS_ACCESS_MODE=auto
JURIS_HEADLESS=0
JURIS_USE_XVFB=1
JURIS_CHALLENGE_TIMEOUT_MS=60000
MAX_DOCUMENTS=3
MAX_PDF_CHARS=18000
LOCAL_PDF_SCAN_LIMIT=80
LOCAL_PDF_TIMEOUT_MS=12000
BATCH_PAGE_SIZE=100
BATCH_MAX_PAGES=500
BATCH_DELAY_MS=350
BATCH_SEARCH_DELAY_MS=4000
# manual | automatic | delayed
BATCH_RETRY_MODE=manual
BATCH_RETRY_ATTEMPTS=2
# 120000 = 2 minutos
BATCH_RETRY_DELAY_MS=120000

# Opcional: habilita la síntesis con OpenCode.
# El modelo debe ser uno disponible en tu configuración de OpenCode.
OPENCODE_ENABLED=1
OPENCODE_MODEL=opencode/nemotron-3.5-lightning-free
# NVIDIA ofrece modelos open con acceso gratuito sujeto a sus límites; requiere una API key propia.
# NVIDIA_API_KEY=
